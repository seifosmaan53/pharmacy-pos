# Copy this file to .env and fill in real values before running anything:
#   cp .env.example .env

# SQLite connection string used by Prisma (prisma/schema.prisma).
# The default below creates a local dev.db file next to schema.prisma.
DATABASE_URL="file:./dev.db"

# Signs and verifies session JWTs (lib/session.ts). Must be a random string
# of at least 32 characters — the app throws on startup otherwise, since a
# short/guessable secret would let anyone forge a manager session.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-string-at-least-32-characters-long"

# Currency label shown throughout the UI and receipts (lib/money.ts). Purely
# cosmetic — all amounts are still stored and computed as integer cents.
NEXT_PUBLIC_CURRENCY="KSh"
